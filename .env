# AutoMarketer AI Configuration
#
# After the NestJS backend was added, the frontend talks ONLY to the backend.
# n8n is still mandatory but is reached via the backend's AI module — not directly
# from the browser. Hugging Face credentials live in backend/.env.

# ------------------------------------------------------------------
# Frontend Configuration (React + Vite)
# ------------------------------------------------------------------

# NestJS REST API base URL
VITE_API_URL=http://localhost:3000/api/v1

# WebSocket URL for real-time KPI data (NestJS gateway, JWT in ?token=)
VITE_WEBSOCKET_URL=ws://localhost:3000/ws
