# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=automarketer
DATABASE_PASSWORD=automarketer
DATABASE_NAME=automarketer
DATABASE_SYNC=false
DATABASE_LOGGING=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- AI Provider ---
# Gemini is the primary provider. App boot fails without GEMINI_API_KEY.
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=30000

# n8n is OPTIONAL. If reachable, used as a secondary path; otherwise ignored.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/automarketer
N8N_WEBHOOK_TIMEOUT_MS=15000

# n8n REST API (used by the Workflow tab to create/activate/delete real n8n workflows).
# Generate the API key inside n8n: Settings -> n8n API -> Create API key.
# Leave N8N_API_KEY empty to disable — workflows will only save in the local DB.
N8N_API_URL=http://localhost:5678/api/v1
N8N_API_KEY=
N8N_API_TIMEOUT_MS=10000

# --- Realtime ---
WS_KPI_TICK_MS=5000
