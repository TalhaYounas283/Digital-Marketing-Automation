# --- Server ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=automarketer
DATABASE_PASSWORD=automarketer
DATABASE_NAME=automarketer
DATABASE_SYNC=false
DATABASE_LOGGING=false

# --- JWT ---
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# --- AI Provider Routing ---
# n8n is the REQUIRED primary provider. App fails to boot without N8N_WEBHOOK_URL.
N8N_WEBHOOK_URL=http://localhost:5678/webhook/automarketer
N8N_WEBHOOK_TIMEOUT_MS=15000

# Hugging Face is the OPTIONAL secondary provider. Disabled by default.
AI_HF_FALLBACK_ENABLED=false
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_TEXT_MODEL=meta-llama/Meta-Llama-3-8B-Instruct
HUGGINGFACE_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# --- Realtime ---
WS_KPI_TICK_MS=5000
